---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { supportedLang } from "@/lib/utils/languageParser";
import { getTranslations } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
}

const lang = Astro.url.searchParams.get("lang") || "en";

const {
  thank_you_title,
  thank_you_message,
  back_home,
} = await getTranslations(lang);
---

<Base title={thank_you_title}>
  <PageHeader title={thank_you_title} />

  <section class="section-sm">
    <div class="container text-center">
      <h2 class="mb-4">✅ {thank_you_title}</h2>

      <p class="mb-6">
        {thank_you_message}
      </p>

      <a href={`/${lang}`} class="btn btn-primary">
        {back_home}
      </a>
    </div>
  </section>
</Base>