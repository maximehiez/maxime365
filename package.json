{
  "name": "astroplate",
  "version": "4.0.1",
  "description": "Astro and Tailwindcss boilerplate",
  "author": "zeon.studio",
  "license": "MIT",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run generate-json && astro dev",
    "build": "npm run generate-json && astro build",
    "preview": "astro preview",
    "format": "prettier -w ./src",
    "check": "astro check",
    "generate-json": "node scripts/jsonGenerator.js",
    "remove-darkmode": "node scripts/removeDarkmode.js && npm run format",
    "remove-multilang": "node scripts/removeMultilang.js && npm run format"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.10",
    "astro-auto-import": "^0.6.0",
    "astro-font": "^1.2.0",
    "date-fns": "^4.4.0",
    "disqus-react": "^1.1.7",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-lite-youtube-embed": "^3.6.2",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "^1.97.1",
    "sharp": "^0.35.2",
    "tailwind-bootstrap-grid": "^5.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
